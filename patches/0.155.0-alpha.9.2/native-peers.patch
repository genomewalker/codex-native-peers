+++ b/codex-rs/peer-messaging/src/lib.rs
@@ -0,0 +1,282 @@
+//! Local peer messaging compatible with Claude Code's Unix-socket registry.
+
+mod registry;
+mod wire;
+
+use std::io;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+
+use async_channel::Receiver;
+use codex_uds::UnixListener;
+use codex_uds::UnixStream;
+use rand::RngCore;
+use serde::Serialize;
+use serde_json::json;
+use tokio::io::AsyncWriteExt;
+use tokio_util::sync::CancellationToken;
+use uuid::Uuid;
+
+const HEARTBEAT_INTERVAL: Duration = Duration::from_secs(3);
+pub const MAX_MESSAGE_BYTES: usize = 32 * 1024;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PeerBridgePaths {
+    pub registry_dir: PathBuf,
+    pub socket_dir: PathBuf,
+}
+
+impl PeerBridgePaths {
+    pub fn for_home(home: &Path) -> Self {
+        Self {
+            registry_dir: home.join(".claude").join("sessions"),
+            socket_dir: registry::runtime_socket_dir(),
+        }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PeerIdentity {
+    pub name: String,
+    pub session_id: String,
+    pub socket_path: PathBuf,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PeerMessage {
+    pub sender_name: String,
+    pub sender_session_id: Option<String>,
+    pub content: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, serde::Deserialize)]
+pub struct PeerSession {
+    pub name: String,
+    pub status: String,
+    pub cwd: String,
+    pub pid: i64,
+}
+
+#[derive(Clone)]
+pub(crate) struct PrivateIdentity {
+    pub(crate) process_registration: bool,
+    pub(crate) public: PeerIdentity,
+    pub(crate) peer_token: String,
+    pub(crate) started_at: i64,
+}
+
+pub struct PeerBridge {
+    identity: PrivateIdentity,
+    paths: PeerBridgePaths,
+    cancellation: CancellationToken,
+    is_shutdown: AtomicBool,
+}
+
+impl PeerBridge {
+    pub async fn start(
+        paths: PeerBridgePaths,
+        requested_name: Option<&str>,
+        session_id: String,
+        cwd: PathBuf,
+    ) -> io::Result<(Self, Receiver<PeerMessage>)> {
+        Self::start_inner(paths, requested_name, session_id, cwd, false).await
+    }
+
+    /// One worker per process, for Claude's PID-keyed discovery registry.
+    pub async fn start_process(
+        paths: PeerBridgePaths,
+        requested_name: Option<&str>,
+        session_id: String,
+        cwd: PathBuf,
+    ) -> io::Result<(Self, Receiver<PeerMessage>)> {
+        Self::start_inner(paths, requested_name, session_id, cwd, true).await
+    }
+
+    async fn start_inner(
+        paths: PeerBridgePaths,
+        requested_name: Option<&str>,
+        session_id: String,
+        cwd: PathBuf,
+        process_registration: bool,
+    ) -> io::Result<(Self, Receiver<PeerMessage>)> {
+        registry::prepare_private_dir(&paths.registry_dir)?;
+        codex_uds::prepare_private_socket_directory(&paths.socket_dir).await?;
+
+        let pid = std::process::id();
+        let name = registry::normalize_name(requested_name, pid);
+        // Each desktop thread owns a distinct socket, even within one process.
+        let socket_path = paths
+            .socket_dir
+            .join(format!("{pid}-{}.sock", Uuid::now_v7()));
+        let mut listener = UnixListener::bind(&socket_path).await?;
+
+        let mut token = [0_u8; 16];
+        rand::rng().fill_bytes(&mut token);
+        let identity = PrivateIdentity {
+            process_registration,
+            public: PeerIdentity {
+                name,
+                session_id,
+                socket_path,
+            },
+            peer_token: registry::hex_encode(&token),
+            started_at: registry::now_ms(),
+        };
+        registry::write_registry(&paths, &identity, &cwd)?;
+
+        let cancellation = CancellationToken::new();
+        let (message_tx, message_rx) = async_channel::bounded(64);
+        spawn_heartbeat(paths.clone(), identity.clone(), cwd, cancellation.clone());
+        let listener_identity = identity.clone();
+        let listener_cancellation = cancellation.clone();
+        tokio::spawn(async move {
+            loop {
+                let stream = tokio::select! {
+                    _ = listener_cancellation.cancelled() => break,
+                    accepted = listener.accept() => match accepted {
+                        Ok(stream) => stream,
+                        Err(_) => break,
+                    },
+                };
+                let token = listener_identity.peer_token.clone();
+                let message_tx = message_tx.clone();
+                tokio::spawn(async move {
+                    let _ = wire::handle_connection(stream, &token, &message_tx).await;
+                });
+            }
+        });
+
+        Ok((
+            Self {
+                identity,
+                paths,
+                cancellation,
+                is_shutdown: AtomicBool::new(false),
+            },
+            message_rx,
+        ))
+    }
+
+    pub fn identity(&self) -> &PeerIdentity {
+        &self.identity.public
+    }
+
+    pub async fn list_sessions(&self) -> Result<Vec<PeerSession>, String> {
+        let registry_dir = self.paths.registry_dir.clone();
+        let own_socket = self
+            .identity
+            .public
+            .socket_path
+            .to_string_lossy()
+            .into_owned();
+        tokio::task::spawn_blocking(move || {
+            registry::read_live_records(&registry_dir)
+                .into_iter()
+                .filter(|record| record.messaging_socket_path != own_socket)
+                .map(|record| PeerSession {
+                    name: record.name,
+                    status: record.status,
+                    cwd: record.cwd,
+                    pid: record.pid,
+                })
+                .collect()
+        })
+        .await
+        .map_err(|err| format!("cannot list peer sessions: {err}"))
+    }
+
+    pub async fn send(&self, recipient: &str, content: &str) -> Result<(), String> {
+        if content.trim().is_empty() {
+            return Err("message content cannot be empty".to_string());
+        }
+        if content.len() > MAX_MESSAGE_BYTES {
+            return Err(format!(
+                "message content exceeds the {MAX_MESSAGE_BYTES}-byte limit"
+            ));
+        }
+        let registry_dir = self.paths.registry_dir.clone();
+        let recipient_name = recipient.to_string();
+        let (target, peer_token) = tokio::task::spawn_blocking(move || {
+            let target = registry::resolve_live_record(&registry_dir, &recipient_name)?;
+            let peer_token = registry::read_peer_token(&registry_dir, &target)?;
+            Ok::<_, String>((target, peer_token))
+        })
+        .await
+        .map_err(|err| format!("cannot resolve peer session: {err}"))??;
+        let mut stream = UnixStream::connect(&target.messaging_socket_path)
+            .await
+            .map_err(|err| format!("cannot connect to '{recipient}': {err}"))?;
+        let auth = json!({ "type": "auth", "token": peer_token });
+        let message = json!({
+            "msgV": 1,
+            "msg_id": Uuid::now_v7().to_string(),
+            "type": "user",
+            "message": {
+                "role": "user",
+                "content": wire::wrap_content(&self.identity.public, content),
+            },
+            "priority": "next",
+            "from": format!("uds:{}", self.identity.public.socket_path.display()),
+        });
+        stream
+            .write_all(format!("{auth}\n{message}\n").as_bytes())
+            .await
+            .map_err(|err| format!("cannot write to '{recipient}': {err}"))?;
+        stream
+            .flush()
+            .await
+            .map_err(|err| format!("cannot flush message to '{recipient}': {err}"))
+    }
+
+    pub fn shutdown(&self) {
+        if self.is_shutdown.swap(true, Ordering::AcqRel) {
+            return;
+        }
+        self.cancellation.cancel();
+        registry::cleanup(&self.paths, &self.identity);
+    }
+}
+
+impl Drop for PeerBridge {
+    fn drop(&mut self) {
+        self.shutdown();
+    }
+}
+
+fn spawn_heartbeat(
+    paths: PeerBridgePaths,
+    identity: PrivateIdentity,
+    cwd: PathBuf,
+    cancellation: CancellationToken,
+) {
+    tokio::spawn(async move {
+        let mut ticker = tokio::time::interval(HEARTBEAT_INTERVAL);
+        loop {
+            tokio::select! {
+                _ = cancellation.cancelled() => break,
+                _ = ticker.tick() => {
+                    let paths = paths.clone();
+                    let identity = identity.clone();
+                    let cwd = cwd.clone();
+                    let write_cancellation = cancellation.clone();
+                    let _ = tokio::task::spawn_blocking(move || {
+                        registry::refresh_registry(
+                            &paths,
+                            &identity,
+                            &cwd,
+                            &write_cancellation,
+                        )
+                    }).await;
+                }
+            }
+        }
+    });
+}
