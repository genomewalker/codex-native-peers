+use std::fs;
+use std::io;
+use std::io::Read as _;
+use std::io::Write as _;
+#[cfg(unix)]
+use std::os::unix::fs::FileTypeExt;
+#[cfg(unix)]
+use std::os::unix::fs::PermissionsExt;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::Mutex;
+use std::sync::OnceLock;
+use std::time::Duration;
+use std::time::SystemTime;
+use std::time::UNIX_EPOCH;
+
+use serde::Deserialize;
+use serde_json::json;
+use sha2::Digest;
+use sha2::Sha256;
+use tokio_util::sync::CancellationToken;
+
+use super::PeerBridgePaths;
+use super::PrivateIdentity;
+
+const CLAUDE_PEER_COMPAT_VERSION: &str = "2.1.239";
+const LIVE_RECORD_MAX_AGE: Duration = Duration::from_secs(30);
+const MAX_CWD_BYTES: usize = 1_024;
+const MAX_LISTED_SESSIONS: usize = 16;
+const MAX_NAME_BYTES: usize = 128;
+const MAX_PEER_KEY_BYTES: u64 = 4 * 1_024;
+const MAX_PEER_TOKEN_BYTES: usize = 256;
+const MAX_REGISTRY_BYTES: u64 = 16 * 1_024;
+const MAX_REGISTRY_FILES: usize = 256;
+const MAX_SOCKET_PATH_BYTES: usize = 4_096;
+const MAX_STATUS_BYTES: usize = 64;
+
+static REGISTRY_WRITE_LOCK: OnceLock<Mutex<()>> = OnceLock::new();
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct PeerKey {
+    peer_token: String,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct RegistryRecord {
+    pub(crate) pid: i64,
+    pub(crate) cwd: String,
+    pub(crate) messaging_socket_path: String,
+    pub(crate) name: String,
+    #[serde(default = "unknown_status")]
+    pub(crate) status: String,
+    pub(crate) updated_at: i64,
+    #[serde(default)]
+    pub(crate) proc_start: Option<String>,
+}
+
+pub(crate) fn prepare_private_dir(path: &Path) -> io::Result<()> {
+    fs::create_dir_all(path)?;
+    set_file_mode(path, 0o700)
+}
+
+pub(crate) fn normalize_name(requested_name: Option<&str>, pid: u32) -> String {
+    let normalized = requested_name
+        .unwrap_or_default()
+        .chars()
+        .filter(|character| {
+            character.is_ascii_alphanumeric() || matches!(character, '-' | '_' | '.')
+        })
+        .take(48)
+        .collect::<String>();
+    if normalized.is_empty() {
+        format!("codex-{pid}")
+    } else {
+        normalized
+    }
+}
+
+pub(crate) fn read_live_records(registry_dir: &Path) -> Vec<RegistryRecord> {
+    let mut records = read_candidate_records(registry_dir);
+    records.sort_by(|left, right| left.name.cmp(&right.name));
+    records.truncate(MAX_LISTED_SESSIONS);
+    records
+}
+
+#[cfg(test)]
+pub(crate) fn find_live_record(registry_dir: &Path, recipient: &str) -> Option<RegistryRecord> {
+    read_candidate_records(registry_dir)
+        .into_iter()
+        .filter(|record| record.name == recipient)
+        .max_by_key(|record| record.updated_at)
+}
+
+pub(crate) fn resolve_live_record(
+    registry_dir: &Path,
+    recipient: &str,
+) -> Result<RegistryRecord, String> {
+    let mut matches = read_candidate_records(registry_dir)
+        .into_iter()
+        .filter(|record| record.name == recipient)
+        .collect::<Vec<_>>();
+    match matches.len() {
+        0 => Err(format!("no live session named '{recipient}' found")),
+        1 => Ok(matches.pop().expect("one peer record")),
+        _ => {
+            matches.sort_by_key(|record| record.pid);
+            let pids = matches
+                .iter()
+                .map(|record| record.pid.to_string())
+                .collect::<Vec<_>>()
+                .join(", ");
+            Err(format!(
+                "multiple live sessions named '{recipient}' found (pids: {pids}); use unique peer names"
+            ))
+        }
+    }
+}
+
+fn read_candidate_records(registry_dir: &Path) -> Vec<RegistryRecord> {
+    let minimum_updated_at =
+        now_ms().saturating_sub(i64::try_from(LIVE_RECORD_MAX_AGE.as_millis()).unwrap_or(i64::MAX));
+    let Ok(entries) = fs::read_dir(registry_dir) else {
+        return Vec::new();
+    };
+    let mut entries = entries
+        .flatten()
+        .filter(|entry| entry.path().extension().and_then(|value| value.to_str()) == Some("json"))
+        .collect::<Vec<_>>();
+    entries.sort_by_key(|entry| {
+        std::cmp::Reverse(
+            entry
+                .metadata()
+                .and_then(|metadata| metadata.modified())
+                .unwrap_or(UNIX_EPOCH),
+        )
+    });
+
+    let mut records = Vec::new();
+    for entry in entries.into_iter().take(MAX_REGISTRY_FILES) {
+        let path = entry.path();
+        let Ok(body) = read_string_with_limit(&path, MAX_REGISTRY_BYTES) else {
+            continue;
+        };
+        let Ok(record) = serde_json::from_str::<RegistryRecord>(&body) else {
+            continue;
+        };
+        let fields_are_valid = !record.name.is_empty()
+            && record.name.len() <= MAX_NAME_BYTES
+            && record.cwd.len() <= MAX_CWD_BYTES
+            && record.status.len() <= MAX_STATUS_BYTES
+            && !record.messaging_socket_path.is_empty()
+            && record.messaging_socket_path.len() <= MAX_SOCKET_PATH_BYTES;
+        let is_live = fields_are_valid
+            && native_socket_path_exists(&record.messaging_socket_path)
+            && process_is_live(&record, minimum_updated_at);
+        if is_live {
+            records.push(record);
+        } else {
+            remove_stale_record(registry_dir, &path, &record);
+        }
+    }
+    records
+}
+
+fn remove_stale_record(registry_dir: &Path, record_path: &Path, record: &RegistryRecord) {
+    let _ = fs::remove_file(record_path);
+    let _ = fs::remove_file(registry_dir.join(format!(
+        "{}.{}.key",
+        record.pid,
+        sha256_hex(&record.messaging_socket_path)
+    )));
+}
+
+fn native_socket_path_exists(socket_path: &str) -> bool {
+    let Ok(metadata) = fs::symlink_metadata(socket_path) else {
+        return false;
+    };
+    #[cfg(unix)]
+    {
+        metadata.file_type().is_socket()
+    }
+    #[cfg(not(unix))]
+    {
+        metadata.is_file()
+    }
+}
+
+fn process_is_live(record: &RegistryRecord, minimum_updated_at: i64) -> bool {
+    #[cfg(target_os = "linux")]
+    {
+        let Ok(pid) = u32::try_from(record.pid) else {
+            return false;
+        };
+        if pid == 0 {
+            return false;
+        }
+        if let Some(record_start) = record
+            .proc_start
+            .as_deref()
+            .filter(|value| !value.is_empty())
+        {
+            let current_start = process_start(pid);
+            return !current_start.is_empty() && record_start == current_start;
+        }
+        record.updated_at >= minimum_updated_at
+    }
+    #[cfg(all(unix, not(target_os = "linux")))]
+    {
+        let Ok(pid) = u32::try_from(record.pid) else {
+            return false;
+        };
+        if pid == 0 {
+            return false;
+        }
+        let Ok(pid) = libc::pid_t::try_from(pid) else {
+            return false;
+        };
+        let result = unsafe { libc::kill(pid, 0) };
+        let live = result == 0 || io::Error::last_os_error().raw_os_error() == Some(libc::EPERM);
+        if !live {
+            return false;
+        }
+        match record
+            .proc_start
+            .as_deref()
+            .filter(|value| !value.is_empty())
+        {
+            Some(expected) => process_start(pid as u32) == expected,
+            None => record.updated_at >= minimum_updated_at,
+        }
+    }
+    #[cfg(not(unix))]
+    {
+        let Ok(pid) = u32::try_from(record.pid) else {
+            return false;
+        };
+        if pid == 0 {
+            return false;
+        }
+        record.updated_at >= minimum_updated_at
+    }
+}
+
+pub(crate) fn read_peer_token(
+    registry_dir: &Path,
+    record: &RegistryRecord,
+) -> Result<String, String> {
+    let key_path = registry_dir.join(format!(
+        "{}.{}.key",
+        record.pid,
+        sha256_hex(&record.messaging_socket_path)
+    ));
+    let key: PeerKey = serde_json::from_str(
+        &read_string_with_limit(&key_path, MAX_PEER_KEY_BYTES)
+            .map_err(|err| format!("cannot read peer key: {err}"))?,
+    )
+    .map_err(|err| format!("cannot parse peer key: {err}"))?;
+    if key.peer_token.len() > MAX_PEER_TOKEN_BYTES {
+        return Err("peer token exceeds the size limit".to_string());
+    }
+    Ok(key.peer_token)
+}
+
+pub(crate) fn write_registry(
+    paths: &PeerBridgePaths,
+    identity: &PrivateIdentity,
+    cwd: &Path,
+) -> io::Result<()> {
+    let _guard = registry_write_lock();
+    write_registry_inner(paths, identity, cwd)
+}
+
+pub(crate) fn refresh_registry(
+    paths: &PeerBridgePaths,
+    identity: &PrivateIdentity,
+    cwd: &Path,
+    cancellation: &CancellationToken,
+) -> io::Result<()> {
+    let _guard = registry_write_lock();
+    if cancellation.is_cancelled() {
+        return Ok(());
+    }
+    write_registry_inner(paths, identity, cwd)
+}
+
+fn write_registry_inner(
+    paths: &PeerBridgePaths,
+    identity: &PrivateIdentity,
+    cwd: &Path,
+) -> io::Result<()> {
+    prepare_private_dir(&paths.registry_dir)?;
+    let pid = std::process::id();
+    let updated_at = now_ms();
+    let socket_path = identity.public.socket_path.to_string_lossy();
+    let mut record = json!({
+        "pid": pid,
+        "sessionId": identity.public.session_id,
+        "cwd": cwd.to_string_lossy(),
+        "startedAt": identity.started_at,
+        "procStart": process_start(pid),
+        "version": CLAUDE_PEER_COMPAT_VERSION,
+        "peerProtocol": 1,
+        "peerFeatures": ["notify_idle"],
+        "kind": "interactive",
+        "entrypoint": "cli",
+        "messagingSocketPath": socket_path,
+        "name": identity.public.name,
+        "nameSource": "user",
+        "nameSince": identity.started_at,
+        "status": "idle",
+        "updatedAt": updated_at,
+        "statusUpdatedAt": updated_at,
+    });
+    if cfg!(target_os = "macos") {
+        record["pidDomain"] = json!("darwin");
+    }
+    atomic_write(
+        &paths.registry_dir.join(if identity.process_registration {
+            format!("{pid}.json")
+        } else {
+            format!("{pid}-{}.json", sha256_hex(&socket_path))
+        }),
+        record.to_string().as_bytes(),
+        0o644,
+    )?;
+    let mut key = json!({
+        "peerToken": identity.peer_token,
+        "procStart": process_start(pid),
+    });
+    if cfg!(target_os = "macos") {
+        key["pidDomain"] = json!("darwin");
+    }
+    atomic_write(
+        &paths
+            .registry_dir
+            .join(format!("{pid}.{}.key", sha256_hex(&socket_path))),
+        key.to_string().as_bytes(),
+        0o600,
+    )
+}
+
+pub(crate) fn cleanup(paths: &PeerBridgePaths, identity: &PrivateIdentity) {
+    let _guard = registry_write_lock();
+    let pid = std::process::id();
+    let socket_path = identity.public.socket_path.to_string_lossy();
+    let _ = fs::remove_file(&identity.public.socket_path);
+    let _ = fs::remove_file(paths.registry_dir.join(if identity.process_registration {
+        format!("{pid}.json")
+    } else {
+        format!("{pid}-{}.json", sha256_hex(&socket_path))
+    }));
+    let _ = fs::remove_file(
+        paths
+            .registry_dir
+            .join(format!("{pid}.{}.key", sha256_hex(&socket_path))),
+    );
+}
+
+pub(crate) fn runtime_socket_dir() -> PathBuf {
+    if let Some(path) = std::env::var_os("XDG_RUNTIME_DIR") {
+        return PathBuf::from(path).join("codex-peer-messaging");
+    }
+    #[cfg(unix)]
+    let user = unsafe { libc::getuid() }.to_string();
+    #[cfg(not(unix))]
+    let user = "windows".to_string();
+    #[cfg(target_os = "macos")]
+    let base = PathBuf::from("/tmp");
+    #[cfg(not(target_os = "macos"))]
+    let base = std::env::temp_dir();
+    base.join(format!("codex-peer-messaging-{user}"))
+}
+
+pub(crate) fn sha256_hex(input: &str) -> String {
+    hex_encode(&Sha256::digest(input.as_bytes()))
+}
+
+pub(crate) fn hex_encode(bytes: &[u8]) -> String {
+    let mut output = String::with_capacity(bytes.len() * 2);
+    for byte in bytes {
+        use std::fmt::Write as _;
+        let _ = write!(output, "{byte:02x}");
+    }
+    output
+}
+
+fn registry_write_lock() -> std::sync::MutexGuard<'static, ()> {
+    REGISTRY_WRITE_LOCK
+        .get_or_init(|| Mutex::new(()))
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+}
+
+fn atomic_write(path: &Path, content: &[u8], mode: u32) -> io::Result<()> {
+    let temp_path = path.with_extension(format!("tmp.{}", std::process::id()));
+    let mut file = fs::File::create(&temp_path)?;
+    file.write_all(content)?;
+    file.flush()?;
+    set_file_mode(&temp_path, mode)?;
+    fs::rename(temp_path, path)
+}
+
+fn read_string_with_limit(path: &Path, max_bytes: u64) -> io::Result<String> {
+    let mut content = String::new();
+    fs::File::open(path)?
+        .take(max_bytes.saturating_add(1))
+        .read_to_string(&mut content)?;
+    if u64::try_from(content.len()).unwrap_or(u64::MAX) > max_bytes {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "peer registry file exceeds the size limit",
+        ));
+    }
+    Ok(content)
+}
+
+fn unknown_status() -> String {
+    "unknown".to_string()
+}
+
+#[cfg(unix)]
+fn set_file_mode(path: &Path, mode: u32) -> io::Result<()> {
+    fs::set_permissions(path, fs::Permissions::from_mode(mode))
+}
+
+#[cfg(not(unix))]
+fn set_file_mode(_path: &Path, _mode: u32) -> io::Result<()> {
+    Ok(())
+}
+
+fn process_start(pid: u32) -> String {
+    #[cfg(target_os = "macos")]
+    {
+        fn query(pid: u32) -> String {
+            std::process::Command::new("/bin/ps")
+                .args(["-p", &pid.to_string(), "-o", "lstart="])
+                .env("TZ", "UTC")
+                .env("LC_ALL", "C")
+                .output()
+                .ok()
+                .filter(|output| output.status.success())
+                .map(|output| String::from_utf8_lossy(&output.stdout).trim().to_string())
+                .unwrap_or_default()
+        }
+        static OWN_START: OnceLock<String> = OnceLock::new();
+        if pid == std::process::id() {
+            OWN_START.get_or_init(|| query(pid)).clone()
+        } else {
+            query(pid)
+        }
+    }
+    #[cfg(target_os = "linux")]
+    {
+        let stat = fs::read_to_string(format!("/proc/{pid}/stat")).unwrap_or_default();
+        let Some(end) = stat.rfind(')') else {
+            return String::new();
+        };
+        stat.get(end + 2..)
+            .and_then(|rest| rest.split_whitespace().nth(19))
+            .unwrap_or_default()
+            .to_string()
+    }
+    #[cfg(not(any(target_os = "linux", target_os = "macos")))]
+    String::new()
+}
+
+pub(crate) fn now_ms() -> i64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .ok()
+        .and_then(|duration| i64::try_from(duration.as_millis()).ok())
+        .unwrap_or_default()
+}
+
