+#[test]
+fn session_listing_is_bounded() {
+    let temp = tempfile::Builder::new()
+        .prefix("peers")
+        .tempdir_in("/tmp")
+        .expect("temp dir");
+    let paths = test_paths(&temp);
+    fs::create_dir_all(&paths.registry_dir).expect("registry dir");
+    #[cfg(unix)]
+    let _listeners = (0..17)
+        .map(|index| {
+            StdUnixListener::bind(temp.path().join(format!("peer-{index}.sock")))
+                .expect("socket listener")
+        })
+        .collect::<Vec<_>>();
+    #[cfg(not(unix))]
+    for index in 0..17 {
+        fs::write(temp.path().join(format!("peer-{index}.sock")), "").expect("socket placeholder");
