+use super::*;
+use pretty_assertions::assert_eq;
+use std::fs;
+use tempfile::TempDir;
+
+#[cfg(unix)]
+use std::os::unix::net::UnixListener as StdUnixListener;
+
+fn test_paths(temp: &TempDir) -> PeerBridgePaths {
+    PeerBridgePaths {
+        registry_dir: temp.path().join("registry"),
+        socket_dir: temp.path().join("sockets"),
+    }
+}
+
+#[tokio::test]
+async fn three_tasks_exchange_replies_without_cross_delivery() {
+    let temp = tempfile::Builder::new()
+        .prefix("peers")
+        .tempdir_in("/tmp")
+        .unwrap();
+    let paths = test_paths(&temp);
+    let (a, a_rx) = PeerBridge::start(
+        paths.clone(),
+        Some("task-a"),
+        "a".into(),
+        temp.path().into(),
+    )
+    .await
+    .unwrap();
+    let (b, b_rx) = PeerBridge::start(
+        paths.clone(),
+        Some("task-b"),
+        "b".into(),
+        temp.path().into(),
+    )
+    .await
+    .unwrap();
+    let (c, c_rx) = PeerBridge::start(paths, Some("task-c"), "c".into(), temp.path().into())
+        .await
+        .unwrap();
+    assert_eq!(
+        a.list_sessions()
+            .await
+            .unwrap()
+            .iter()
+            .map(|p| p.name.as_str())
+            .collect::<Vec<_>>(),
+        vec!["task-b", "task-c"]
+    );
+    a.send("task-b", "request").await.unwrap();
+    let request = tokio::time::timeout(Duration::from_secs(2), b_rx.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(
+        request,
+        PeerMessage {
+            sender_name: "task-a".into(),
+            sender_session_id: Some("a".into()),
+            content: "request".into()
+        }
+    );
+    b.send(&request.sender_name, "reply").await.unwrap();
+    assert_eq!(
+        tokio::time::timeout(Duration::from_secs(2), a_rx.recv())
+            .await
+            .unwrap()
+            .unwrap()
+            .content,
+        "reply"
+    );
+    assert!(c_rx.is_empty());
+    b.shutdown();
+    assert!(a.send("task-b", "closed").await.is_err());
+    a.send("task-c", "still alive").await.unwrap();
+    assert_eq!(
+        tokio::time::timeout(Duration::from_secs(2), c_rx.recv())
+            .await
+            .unwrap()
+            .unwrap()
+            .content,
+        "still alive"
+    );
+    assert!(c.identity().socket_path.exists());
+}
