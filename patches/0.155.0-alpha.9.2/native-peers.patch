+    let error = match registry::resolve_live_record(&paths.registry_dir, "duplicate") {
+        Ok(_) => panic!("duplicate peer names must be ambiguous"),
+        Err(error) => error,
+    };
+    assert!(error.contains("multiple live sessions named 'duplicate'"));
+}
