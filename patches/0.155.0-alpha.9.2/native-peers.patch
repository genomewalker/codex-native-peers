+//! Disposable interoperability probe. Exits after one request and reply.
+use codex_peer_messaging::PeerBridge;
+use codex_peer_messaging::PeerBridgePaths;
+use std::path::PathBuf;
+use std::time::Duration;
+
+#[tokio::main]
+async fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let home = PathBuf::from(std::env::var_os("HOME").ok_or("HOME missing")?);
+    let name = format!("relay-native-test-{}", std::process::id());
+    let (bridge, receiver) = PeerBridge::start(
+        PeerBridgePaths::for_home(&home),
+        Some(&name),
+        uuid::Uuid::now_v7().to_string(),
+        std::env::current_dir()?,
+    )
+    .await?;
+    println!("READY {name}");
+    let message = tokio::time::timeout(Duration::from_secs(120), receiver.recv()).await??;
+    if message.content.trim() != "relay-native-roundtrip" {
+        return Err("unexpected probe content".into());
+    }
+    bridge
+        .send(&message.sender_name, "relay-native-roundtrip-confirmed")
+        .await?;
+    println!("REPLIED to {}", message.sender_name);
+    // Keep the sender's identity alive while Claude validates the reply.
+    tokio::time::sleep(Duration::from_secs(15)).await;
+    Ok(())
+}
+
