@@ -0,0 +1,61 @@
+//! Native, event-driven per-task adapter for Claude's PID registry.
+use codex_peer_messaging::PeerBridge;
+use codex_peer_messaging::PeerBridgePaths;
+use serde_json::Value;
+use serde_json::json;
+use std::path::PathBuf;
+use tokio::io::AsyncBufReadExt;
+use tokio::io::AsyncReadExt;
+use tokio::io::AsyncWriteExt;
+use tokio::io::BufReader;
+
+#[tokio::main(flavor = "current_thread")]
+async fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let mut args = std::env::args().skip(1);
+    let thread = args.next().ok_or("thread missing")?;
+    let home = PathBuf::from(args.next().ok_or("home missing")?);
+    let cwd = PathBuf::from(args.next().ok_or("cwd missing")?);
+    let (bridge, receiver) = PeerBridge::start_process(
+        PeerBridgePaths::for_home(&home),
+        Some(&format!("codex-{thread}")),
+        thread,
+        cwd,
+    )
+    .await?;
+    let mut output = tokio::io::stdout();
+    output.write_all(b"{\"ready\":true}\n").await?;
+    output.flush().await?;
+    let mut input = BufReader::new(tokio::io::stdin());
+    let mut line = Vec::new();
+    loop {
+        let mut bounded = (&mut input).take(65537 - line.len() as u64);
+        let result = tokio::select! {
+            read = bounded.read_until(b'\n', &mut line) => {
+                if read? == 0 { break; }
+                if line.len() > 65536 || !line.ends_with(b"\n") { break; }
+                let request: Value = serde_json::from_slice(&line)?;
+                line.clear();
+                let id = request["id"].clone();
+                let response = match request["op"].as_str() {
+                    Some("list") => bridge.list_sessions().await.map(|peers| json!(peers)),
+                    Some("send") => match (request["recipient"].as_str(), request["content"].as_str()) {
+                        (Some(to), Some(content)) => bridge.send(to, content).await.map(|()| json!("sent")),
+                        _ => Err("recipient/content missing".into()),
+                    },
+                    Some("shutdown") => break,
+                    _ => Err("unknown operation".into()),
+                };
+                match response { Ok(value) => json!({"id":id,"result":value}), Err(error) => json!({"id":id,"error":error}) }
+            }
+            received = receiver.recv() => {
+                let message = received?;
+                json!({"event":"message","sender":message.sender_name,"session":message.sender_session_id,"content":message.content})
+            }
+        };
+        output.write_all(format!("{result}\n").as_bytes()).await?;
+        output.flush().await?;
+    }
+    bridge.shutdown();
+    Ok(())
+}
+
