+        let record = json!({
+            "pid": std::process::id(),
+            "cwd": "/tmp",
+            "messagingSocketPath": socket_path,
+            "name": "duplicate",
+            "status": "idle",
+            "updatedAt": registry::now_ms(),
+            "procStart": if cfg!(target_os = "linux") {
+                fs::read_to_string(format!("/proc/{}/stat", std::process::id()))
+                    .ok()
+                    .and_then(|stat| {
+                        let end = stat.rfind(')')?;
+                        stat.get(end + 2..)?
+                            .split_whitespace()
+                            .nth(19)
+                            .map(str::to_string)
+                    })
+                    .unwrap_or_default()
+            } else {
+                String::new()
+            },
+        });
