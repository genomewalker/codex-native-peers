new file mode 100644
--- /dev/null
+++ b/codex-rs/peer-messaging/src/wire.rs
@@ -0,0 +1,157 @@
+use tokio::io::AsyncBufRead;
+use tokio::io::AsyncBufReadExt;
+use tokio::io::AsyncReadExt;
+use tokio::io::BufReader;
+
+use async_channel::Sender;
+use codex_uds::UnixStream;
+use constant_time_eq::constant_time_eq;
+use serde::Deserialize;
+
+use super::PeerIdentity;
+use super::PeerMessage;
+
+const MAX_FRAME_BYTES: usize = 64 * 1024;
+const MESSAGE_TAG_OPEN: &str = "<cross-session-message";
+const MESSAGE_TAG_CLOSE: &str = "</cross-session-message>";
+
+pub(crate) async fn handle_connection(
+    stream: UnixStream,
+    expected_token: &str,
+    message_tx: &Sender<PeerMessage>,
+) -> Result<(), String> {
+    let mut reader = BufReader::new(stream);
+    let auth_line = read_limited_line(&mut reader)
+        .await?
+        .ok_or_else(|| "connection closed before authentication".to_string())?;
+    let auth: AuthFrame = serde_json::from_str(&auth_line).map_err(|err| err.to_string())?;
+    if auth.frame_type != "auth"
+        || !constant_time_eq(auth.token.as_bytes(), expected_token.as_bytes())
+    {
+        return Err("peer authentication failed".to_string());
+    }
+
+    while let Some(line) = read_limited_line(&mut reader).await? {
+        let Ok(frame) = serde_json::from_str::<UserFrame>(&line) else {
+            continue;
+        };
+        if frame.frame_type != "user" || frame.message.content.is_empty() {
+            continue;
+        }
+        message_tx
+            .send(unwrap_content(
+                &frame.message.content,
+                frame.from.as_deref(),
+            ))
+            .await
+            .map_err(|err| err.to_string())?;
+    }
+    Ok(())
+}
+
+pub(crate) fn wrap_content(identity: &PeerIdentity, content: &str) -> String {
+    let content = escape_tags(content);
+    format!(
+        "{MESSAGE_TAG_OPEN} from=\"uds:{socket}\" from-session=\"{session}\" from-name=\"{name}\" from-mode=\"prompting\">\n{content}\n{MESSAGE_TAG_CLOSE}",
+        socket = identity.socket_path.display(),
+        session = identity.session_id,
+        name = identity.name,
+    )
+}
+
+pub(crate) fn unwrap_content(content: &str, fallback_sender: Option<&str>) -> PeerMessage {
+    let trimmed = content.trim();
+    let Some(open_start) = trimmed.find(MESSAGE_TAG_OPEN) else {
+        return plain_message(trimmed, fallback_sender);
+    };
+    let after_open = &trimmed[open_start..];
+    let Some(tag_end) = after_open.find('>') else {
+        return plain_message(trimmed, fallback_sender);
+    };
+    let open_tag = &after_open[..tag_end];
+    let body_start = open_start + tag_end + 1;
+    let body_end = trimmed[body_start..]
+        .find(MESSAGE_TAG_CLOSE)
+        .map_or(trimmed.len(), |offset| body_start + offset);
+    PeerMessage {
+        sender_name: extract_attr(open_tag, "from-name")
+            .or_else(|| fallback_sender.map(str::to_string))
+            .unwrap_or_else(|| "unknown-peer".to_string()),
+        sender_session_id: extract_attr(open_tag, "from-session"),
+        content: unescape_tags(trimmed[body_start..body_end].trim()),
+    }
+}
+
+async fn read_limited_line<R>(reader: &mut R) -> Result<Option<String>, String>
+where
+    R: AsyncBufRead + Unpin,
+{
+    let mut bytes = Vec::new();
+    let read = (&mut *reader)
+        .take((MAX_FRAME_BYTES + 1) as u64)
+        .read_until(b'\n', &mut bytes)
+        .await
+        .map_err(|err| err.to_string())?;
+    if read == 0 {
+        return Ok(None);
+    }
+    if bytes.len() > MAX_FRAME_BYTES || !bytes.ends_with(b"\n") {
+        return Err(format!(
+            "peer frame exceeds the {MAX_FRAME_BYTES}-byte limit"
+        ));
+    }
+    bytes.pop();
+    if bytes.ends_with(b"\r") {
+        bytes.pop();
+    }
+    String::from_utf8(bytes)
+        .map(Some)
+        .map_err(|err| format!("peer frame is not UTF-8: {err}"))
+}
+
+fn plain_message(content: &str, fallback_sender: Option<&str>) -> PeerMessage {
+    PeerMessage {
+        sender_name: fallback_sender.unwrap_or("unknown-peer").to_string(),
+        sender_session_id: None,
+        content: content.to_string(),
+    }
+}
+
+fn extract_attr(tag: &str, attribute: &str) -> Option<String> {
+    let marker = format!("{attribute}=\"");
+    let value = tag.get(tag.find(&marker)? + marker.len()..)?;
+    Some(value.get(..value.find('"')?)?.to_string())
+}
+
+fn escape_tags(content: &str) -> String {
+    content
+        .replace(MESSAGE_TAG_OPEN, "<\\cross-session-message")
+        .replace(MESSAGE_TAG_CLOSE, "<\\/cross-session-message>")
+}
+
+fn unescape_tags(content: &str) -> String {
+    content
+        .replace("<\\cross-session-message", MESSAGE_TAG_OPEN)
+        .replace("<\\/cross-session-message>", MESSAGE_TAG_CLOSE)
+}
+
+#[derive(Deserialize)]
+struct AuthFrame {
+    #[serde(rename = "type")]
+    frame_type: String,
+    token: String,
+}
+
+#[derive(Deserialize)]
+struct UserFrame {
+    #[serde(rename = "type")]
+    frame_type: String,
+    message: UserFrameMessage,
+    from: Option<String>,
+}
+
+#[derive(Deserialize)]
+struct UserFrameMessage {
+    content: String,
+}
